# ─── EmDash (CMS) ────────────────────────────────────────────────────────────
# Clave que cifra secretos de plugins. Generala con:
#   npx emdash secrets generate
# Guardala en un lugar seguro: si se pierde, los secretos cifrados no se pueden leer.
EMDASH_ENCRYPTION_KEY=

# Origen público del sitio (sin barra final). En producción:
#   EMDASH_SITE_URL=https://fsmet.com.ar
# En local se puede dejar vacío; EmDash usa localhost.
EMDASH_SITE_URL=

# ─── Base de datos de producción (Vercel) ───────────────────────────────────
# En local, si no está definida, EmDash usa SQLite en ./data.db.
# En producción hace falta Postgres (Neon, Vercel Postgres, Supabase, etc.):
#   DATABASE_URL=postgres://usuario:password@host:5432/base?sslmode=require
#
# Supabase: usar el Session Pooler (IPv4, puerto 5432). EmDash corre
# migraciones y advisory locks, que funcionan mejor en modo sesión:
#   DATABASE_URL=postgresql://postgres.<project-ref>:<password-encoded>@aws-1-<region>.pooler.supabase.com:5432/postgres
# La conexión directa db.<project-ref>.supabase.co:5432 es solo IPv6.
# Si la contraseña tiene caracteres especiales (@ : / ? # & +), URL-encodeala.
# El proyecto incluye certs/supabase-ca.crt (CA pública de Supabase) y el
# código la usa para verificar TLS; no hace falta agregar sslmode a la URL.
DATABASE_URL=

# ─── Sesiones del admin en producción ───────────────────────────────────────
# El adaptador de Vercel no trae driver de sesiones. Se recomienda Upstash Redis:
#   REDIS_URL=rediss://default:password@host:6379
# Si no se define, se usa Vercel Runtime Cache (puede perder la sesión al
# cambiar de región o instancia).
REDIS_URL=

# ─── Media en producción (S3-compatible: R2, S3, MinIO, Supabase) ───────────
# En local las imágenes se guardan en ./uploads. En Vercel el disco no
# persiste, así que configurá un bucket para poder subir imágenes desde el CMS.
#
# Supabase Storage (habilitar "S3 protocol" en Storage → Settings y generar
# credenciales S3):
#   S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
#   S3_BUCKET=emdash-media
#   S3_REGION=<region-del-proyecto>
#   S3_PUBLIC_URL=https://<project-ref>.supabase.co/storage/v1/object/public/emdash-media
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_PUBLIC_URL=

# ─── Formulario de inscripción (SMTP) ───────────────────────────────────────
# SMTP del correo que envía las inscripciones
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465
#        (requiere 2FA activado + "Contraseña de aplicación", NO la contraseña normal)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# El correo del inscripto va como replyTo para responderle directo.

# Destinatario de las inscripciones: un correo aparte que las recibe.
# El envío sale siempre desde SMTP_USER.
# Si no se configura, las inscripciones llegan al mismo SMTP_USER (auto-mail).
# Ej: fsmet.inscripciones@gmail.com
MAIL_RECIPIENT=

# Cloudflare Turnstile (anti-bot del formulario)
# Site key = pública (va al cliente) · Secret key = privada (solo servidor)
# Si no se configuran, el widget no se renderiza y la verificación se omite
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
