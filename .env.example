# SMTP del correo que envía las inscripciones
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465
#        (requiere 2FA activado + "Contraseña de aplicación", NO la contraseña normal)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Correo destino de las inscripciones (miembro del equipo FSMET)
MAIL_TO=

# Remitente (opcional — por defecto usa SMTP_USER)
# Ej: FSMET <fsmet@gmail.com>
MAIL_FROM=
