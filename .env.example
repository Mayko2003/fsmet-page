# SMTP del correo que envía las inscripciones
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465
#        (requiere 2FA activado + "Contraseña de aplicación", NO la contraseña normal)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# El correo del inscripto va como replyTo para responderle directo.

# Destinatario de las inscripciones: un correo aparte que las recibe.
# El envío sale siempre desde SMTP_USER.
# Si no se configura, las inscripciones llegan al mismo SMTP_USER (auto-mail).
# Ej: fsmet.inscripciones@gmail.com
MAIL_RECIPIENT=

# Cloudflare Turnstile (anti-bot del formulario)
# Site key = pública (va al cliente) · Secret key = privada (solo servidor)
# Si no se configuran, el widget no se renderiza y la verificación se omite
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
