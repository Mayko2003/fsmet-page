---
import { getEmDashEntry } from "emdash";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import PreviewNotice from "../../components/PreviewNotice.astro";
import QuienesSomos from "../../components/QuienesSomos.astro";
import "../../styles/global.css";

const slug = Astro.params.slug;

if (!slug) {
	return Astro.rewrite("/404");
}

const { entry, isPreview, error } = await getEmDashEntry("about", slug, {
	locale: Astro.currentLocale,
});

if (error) {
	console.error("[emdash] No se pudo cargar el preview de about:", error);
	return new Response("No se pudo cargar la vista previa", { status: 500 });
}

if (!entry) {
	if (isPreview) return Astro.rewrite("/404");
	return Astro.redirect("/#quienes-somos");
}

if (!isPreview) {
	return Astro.redirect("/#quienes-somos");
}
---

<Layout title="Vista previa · Quiénes somos">
	<Header />
	<main id="contenido">
		<PreviewNotice label="Vista previa · Quiénes somos" />
		<QuienesSomos previewEntry={entry} />
	</main>
	<Footer />
</Layout>
