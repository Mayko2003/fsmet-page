---
import { Image } from "astro:assets";
import jujuyFondo from "../assets/jujuy-fondo.jpg";
import saltaFondo from "../assets/salta-fondo.jpg";
import { getStrings } from "../i18n/strings";

const s = getStrings(Astro.currentLocale);
const fotos = [jujuyFondo, saltaFondo];
const territorios = s.territorios.cards.map((card, i) => ({ ...card, foto: fotos[i] }));
---

<section id="territorios" class="scroll-mt-24 border-t border-sand">
	<div class="mx-auto max-w-6xl px-5 py-20 md:px-8">
		<p data-reveal class="text-sm font-semibold tracking-widest text-sage uppercase">{s.territorios.label}</p>
		<h2 data-reveal style="--reveal-delay: 80ms" class="mt-3 max-w-3xl font-display text-3xl font-semibold md:text-5xl">
			{s.territorios.h2}
		</h2>
		<p data-reveal style="--reveal-delay: 150ms" class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">
			{s.territorios.intro}
		</p>
		<div class="mt-12 grid gap-6 md:grid-cols-2">
			{
				territorios.map((territorio, i) => (
					<article
						data-reveal
						style={`--reveal-delay: ${i * 120}ms`}
						class="group overflow-hidden rounded-3xl border border-sand bg-paper"
					>
						<div class="relative aspect-[16/9] overflow-hidden">
							<Image
								src={territorio.foto}
								alt={`Paisaje de ${territorio.nombre}`}
								width={1200}
								format="webp"
								quality={75}
								class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
							/>
							<span class="absolute bottom-3 left-3 rounded-full bg-ink/60 px-3 py-1 text-xs font-semibold text-cream backdrop-blur-sm">
								{s.territorios.badge}
							</span>
						</div>
						<div class="p-6 md:p-8">
							<h3 class="font-display text-2xl">{territorio.nombre}</h3>
							<p class="mt-3 leading-relaxed text-muted">{territorio.texto}</p>
						</div>
					</article>
				))
			}
		</div>
		<p data-reveal class="mt-8 text-sm text-muted">
			{s.territorios.footnote}
		</p>
	</div>
</section>
