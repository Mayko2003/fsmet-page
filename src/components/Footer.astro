---
import { Icon } from "astro-icon/components";

const redes = [
	{ icon: "mdi:facebook-box", label: "Facebook" },
	{ icon: "mdi:instagram", label: "Instagram" },
	{ icon: "mdi:whatsapp", label: "WhatsApp" },
	{ icon: "mdi:youtube", label: "YouTube" },
];
---

<footer class="border-t border-sand bg-ink text-cream">
	<div
		class="mx-auto flex max-w-6xl flex-col gap-8 px-5 py-12 md:flex-row md:items-end md:justify-between md:px-8"
	>
		<div>
			<div class="flex items-start gap-4">
				<img
					src="/img/logo.png"
					alt=""
					class="h-14 w-14 rounded-full bg-paper object-cover"
				/>
				<div>
					<p class="font-display text-2xl">FSMET</p>
					<p class="mt-1 max-w-sm text-sm leading-relaxed text-gold-soft">
						Foro Social Mundial de las Economías Transformadoras. Jujuy y Salta,
						Argentina.
					</p>
				</div>
			</div>
			<p class="text-muted mt-4">
				&copy; 2026 FSMET. Todos los derechos reservados
			</p>
		</div>
		<div>
			<p class="text-lg text-cream/70">Encontranos en:</p>
			<ul class="flex gap-3" aria-label="Redes sociales">
				{
					redes.map((red) => (
						<li>
							<span
								title={`${red.label}: próximamente`}
								class="inline-flex opacity-50"
								aria-label={`${red.label} (próximamente)`}
							>
								<Icon name={red.icon} class="size-8" />
							</span>
						</li>
					))
				}
			</ul>
			<p class="mt-4 text-sm text-cream/60">
				Canales oficiales próximamente.
			</p>
			<p class="mt-4 text-sm text-cream/70">
				Proceso en construcción. Memoria, red y territorio.
			</p>
		</div>
	</div>
</footer>
