---
import { Icon } from "astro-icon/components";

export interface CardItem {
	icon: string;
	logo?: string;
	meta: string;
	title: string;
	text: string;
	cta: string;
	url: string;
}

interface Props {
	id: string;
	label: string;
	h2: string;
	intro: string;
	items: CardItem[];
	accent?: "clay" | "sage";
}

const { id, label, h2, intro, items, accent = "clay" } = Astro.props;
const labelClass = accent === "sage" ? "text-sage" : "text-clay";
---

<section id={id} class="scroll-mt-24 border-t border-sand">
	<div class="mx-auto max-w-6xl px-5 py-20 md:px-8">
		<p data-reveal class={`text-sm font-semibold tracking-widest uppercase ${labelClass}`}>
			{label}
		</p>
		<h2
			data-reveal
			style="--reveal-delay: 80ms"
			class="mt-3 max-w-3xl font-display text-3xl font-semibold md:text-5xl"
		>
			{h2}
		</h2>
		<p
			data-reveal
			style="--reveal-delay: 150ms"
			class="mt-6 max-w-2xl text-lg leading-relaxed text-muted"
		>
			{intro}
		</p>
		<ul class="mt-12 grid items-stretch gap-4 sm:grid-cols-2 lg:grid-cols-3">
			{
				items.map((item, i) => (
					<li
						data-reveal
						style={`--reveal-delay: ${i * 80}ms`}
						class="flex flex-col rounded-3xl border border-sand bg-paper p-6"
					>
						{item.logo ? (
							<img
								src={item.logo}
								alt={item.title}
								width="800"
								height="185"
								loading="lazy"
								class="w-full rounded-2xl border border-sand"
							/>
						) : (
							<span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-gold-soft text-clay">
								<Icon name={item.icon} class="h-6 w-6" />
							</span>
						)}
						<h3 class="mt-4 font-display text-xl leading-snug">{item.title}</h3>
						<p class="mt-3">
							<span class="inline-flex rounded-full bg-sand px-3 py-1 text-xs font-semibold text-ink/80">
								{item.meta}
							</span>
						</p>
						<p class="mt-3 text-sm leading-relaxed text-muted">{item.text}</p>
						<div class="mt-auto pt-6">
							<a
								href={item.url}
								target="_blank"
								rel="noopener noreferrer"
								class="inline-flex items-center gap-2 rounded-full bg-clay px-4 py-2 text-sm font-semibold text-paper transition hover:bg-clay-deep"
							>
								{item.cta}
								<Icon name="mdi:open-in-new" class="h-4 w-4" />
							</a>
						</div>
					</li>
				))
			}
		</ul>
	</div>
</section>
