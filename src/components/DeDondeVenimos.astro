---
import Country from "../assets/country.svg";
import { getStrings } from "../i18n/strings";

const s = getStrings(Astro.currentLocale);
const hitos = s.venimos.hitos;
---

<section id="de-donde-venimos" class="scroll-mt-24 border-t border-sand">
	<div class="mx-auto max-w-6xl px-5 py-20 md:px-8">
		<p data-reveal class="text-sm font-semibold tracking-widest text-sky uppercase">{s.venimos.label}</p>
		<h2 data-reveal style="--reveal-delay: 80ms" class="mt-3 max-w-3xl font-display text-3xl font-semibold md:text-5xl">
			{s.venimos.h2}
		</h2>
		<p data-reveal style="--reveal-delay: 150ms" class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">
			{s.venimos.intro}
		</p>
		<div class="mt-12 grid gap-10 lg:grid-cols-2 lg:items-center lg:gap-14">
			<ol data-timeline class="relative space-y-0">
				<li
					data-timeline-line
					aria-hidden="true"
					class="absolute top-0 bottom-0 left-0 w-0.5 list-none bg-gold"
				>
				</li>
				{
					hitos.map((hito, i) => (
						<li data-reveal style={`--reveal-delay: ${i * 80}ms`} class="relative grid gap-4 py-6 pl-6 md:grid-cols-[180px_1fr] md:gap-10">
							<span
								aria-hidden="true"
								class="absolute top-8 -left-[5px] h-3 w-3 rounded-full border-2 border-cream bg-gold"
							>
							</span>
							<div>
								<p class="font-display text-xl font-semibold text-clay">{hito.when}</p>
								<p class="text-sm text-muted">{hito.where}</p>
							</div>
							<p class="leading-relaxed text-ink/90">{hito.text}</p>
						</li>
					))
				}
			</ol>
			<div data-reveal class="flex items-center justify-center">
				<Country class="h-auto w-full" />
			</div>
		</div>
	</div>
</section>
