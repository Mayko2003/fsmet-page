---
import { getStrings } from "../i18n/strings";

const s = getStrings(Astro.currentLocale);
const preguntas = s.preguntas.items;
---

<section id="preguntas" class="scroll-mt-24 border-t border-sand">
	<div class="mx-auto max-w-4xl px-5 py-20 md:px-8">
		<p data-reveal class="text-sm font-semibold tracking-widest text-clay uppercase">
			{s.preguntas.label}
		</p>
		<h2 data-reveal style="--reveal-delay: 80ms" class="mt-3 font-display text-3xl font-semibold md:text-5xl">
			{s.preguntas.h2}
		</h2>
		<div class="mt-10 space-y-3">
			{
				preguntas.map((pregunta, i) => (
					<details
						data-reveal
						style={`--reveal-delay: ${i * 60}ms`}
						class="group rounded-2xl border border-sand bg-paper"
					>
						<summary class="flex items-center justify-between gap-4 p-5 font-medium">
							{pregunta.q}
							<svg
								aria-hidden="true"
								class="h-5 w-5 shrink-0 text-clay transition-transform group-open:rotate-180"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
							>
								<path d="m6 9 6 6 6-6" />
							</svg>
						</summary>
						<p class="px-5 pb-5 leading-relaxed text-muted">{pregunta.a}</p>
					</details>
				))
			}
		</div>
		<p data-reveal class="mt-8 text-sm text-muted">
			{s.preguntas.footerText}{" "}
			<a href="#inscripcion" class="font-semibold text-clay underline underline-offset-4 hover:text-clay-deep">
				{s.preguntas.footerLink}
			</a>
			.
		</p>
	</div>
</section>
