---
const pasos = [
	"Experiencias territoriales",
	"Intercambio",
	"Sistematización",
	"Formación y capacidades",
	"Articulación",
	"Convergencias territoriales",
	"Propuestas y acción colectiva",
	"Incidencia en políticas e instituciones",
	"Transformación territorial",
];

const movimientos = [
	{
		title: "Sistematizar lo que ya existe",
		text: "Identificar y documentar experiencias transformadoras. No se parte de cero.",
	},
	{
		title: "Construir puentes institucionales",
		text: "Vincular prácticas con Estado, universidades, gobiernos locales y otras instituciones.",
	},
	{
		title: "Fortalecer convergencias",
		text: "Conectar procesos locales, provinciales, nacionales, latinoamericanos e internacionales.",
	},
	{
		title: "Narrativas compartidas",
		text: "Mostrar que las alternativas son concretas, viables y ya están ocurriendo en los territorios.",
	},
];
---

<section id="hoja-de-ruta" class="scroll-mt-24 border-t border-sand bg-paper">
	<div class="mx-auto max-w-6xl px-5 py-20 md:px-8">
		<p class="text-sm font-semibold tracking-widest text-sage uppercase">Hoja de ruta</p>
		<h2 class="mt-3 max-w-3xl font-display text-3xl font-semibold md:text-5xl">
			De la experiencia aislada al ecosistema
		</h2>
		<p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">
			La metodología parte de prácticas concretas y, desde ahí, genera reflexión, conocimiento y
			propuestas. El foro no debería terminar cuando termina el encuentro.
		</p>
		<ol class="mt-12 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
			{
				pasos.map((paso, i) => (
					<li class="flex items-start gap-3 rounded-2xl bg-cream p-4">
						<span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-gold-soft text-sm font-semibold text-ink">
							{i + 1}
						</span>
						<span class="font-medium leading-snug">{paso}</span>
					</li>
				))
			}
		</ol>
		<div class="mt-14 grid gap-4 md:grid-cols-2">
			{
				movimientos.map((m) => (
					<article class="rounded-3xl border border-sand p-6">
						<h3 class="font-display text-2xl">{m.title}</h3>
						<p class="mt-3 leading-relaxed text-muted">{m.text}</p>
					</article>
				))
			}
		</div>
	</div>
</section>
