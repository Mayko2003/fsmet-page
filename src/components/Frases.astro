---
const frases = [
	{
		quote: "Pasar de las alternativas dispersas a las convergencias territoriales.",
		note: "Idea central del proceso",
	},
	{
		quote: "Del proyecto al ecosistema.",
		note: "De lo aislado a la red viva",
	},
	{
		quote: "Se investiga para conocer la realidad y transformarla.",
		note: "El conocimiento también nace en el territorio",
	},
	{
		quote: "Del evento al proceso. De la denuncia a la propuesta.",
		note: "Cuatro transiciones que orientan el FSMET",
	},
];
---

<section id="frases" class="scroll-mt-24 border-t border-sand">
	<div class="mx-auto max-w-6xl px-5 py-20 md:px-8">
		<p class="text-sm font-semibold tracking-widest text-clay uppercase">Frases</p>
		<h2 class="mt-3 font-display text-3xl font-semibold md:text-5xl">Palabras que sostienen el proceso</h2>
		<p class="mt-6 max-w-2xl text-lg text-muted">
			Un tono colectivo, territorial y accesible: territorio, comunidad, red, cuidados, Buen Vivir
			y acción colectiva.
		</p>
		<div class="mt-12 grid gap-5 md:grid-cols-2">
			{
				frases.map((f) => (
					<figure class="rounded-3xl bg-ink px-6 py-8 text-cream md:px-8">
						<blockquote class="font-display text-2xl leading-snug md:text-3xl">{f.quote}</blockquote>
						<figcaption class="mt-5 text-sm text-gold-soft">{f.note}</figcaption>
					</figure>
				))
			}
		</div>
	</div>
</section>
