---
import { getStrings } from "../i18n/strings";
import { commas, getSection } from "../lib/emdash-section";

type AxisData = {
	number?: string;
	title?: string;
	text?: string;
	topics?: string;
};

type AboutData = {
	label?: string;
	heading?: string;
	paragraph_1?: string;
	paragraph_2?: string;
	quote?: string;
	quote_caption?: string;
	axes_title?: string;
	axes?: AxisData[];
};

interface Props {
	previewEntry?: { data: AboutData } | null;
}

const { previewEntry } = Astro.props;
const s = getStrings(Astro.currentLocale);
const cms = previewEntry?.data ?? (await getSection<AboutData>("about", Astro.currentLocale));

const ejes =
	cms?.axes?.length ?
		cms.axes.map((eje) => ({
			n: eje.number || "",
			title: eje.title || "",
			text: eje.text || "",
			temas: commas(eje.topics),
		}))
	: s.quienes.ejes;

const about = {
	label: cms?.label || s.quienes.label,
	h2: cms?.heading || s.quienes.h2,
	p1: cms?.paragraph_1 || s.quienes.p1,
	p2: cms?.paragraph_2 || s.quienes.p2,
	quote: cms?.quote || s.quienes.quote,
	quoteCaption: cms?.quote_caption || s.quienes.quoteCaption,
	ejesTitle: cms?.axes_title || s.quienes.ejesTitle,
};
---

<section id="quienes-somos" class="scroll-mt-24 border-t border-sand bg-paper">
	<div class="mx-auto max-w-6xl px-5 py-20 md:px-8">
		<p data-reveal class="text-sm font-semibold tracking-widest text-clay uppercase">{about.label}</p>
		<h2 data-reveal style="--reveal-delay: 80ms" class="mt-3 max-w-3xl font-display text-3xl font-semibold md:text-5xl">
			{about.h2}
		</h2>
		<div data-reveal style="--reveal-delay: 150ms" class="mt-8 grid gap-8 lg:grid-cols-2">
			<p class="text-lg leading-relaxed text-muted">
				{about.p1}
			</p>
			<p class="text-lg leading-relaxed text-muted">
				{about.p2}
			</p>
		</div>
		<div data-reveal class="mt-12 rounded-3xl bg-sand/70 p-6 md:p-8">
			<p class="font-display text-2xl leading-snug text-ink md:text-3xl">
				{about.quote}
			</p>
			<p class="mt-3 max-w-2xl text-muted">
				{about.quoteCaption}
			</p>
		</div>
		<h3 data-reveal class="mt-14 font-display text-2xl font-semibold">{about.ejesTitle}</h3>
		<ul class="mt-6 grid items-start gap-4 sm:grid-cols-2 lg:grid-cols-3">
			{
				ejes.map((eje, i) => (
					<li data-reveal style={`--reveal-delay: ${i * 60}ms`} class="rounded-2xl border border-sand bg-cream">
						<details class="group">
							<summary class="relative p-5 pr-10">
								<span class="text-sm font-semibold text-clay">{eje.n}</span>
								<h4 class="mt-2 font-display text-xl leading-snug">{eje.title}</h4>
								<p class="mt-2 text-sm leading-relaxed text-muted">{eje.text}</p>
								<svg
									aria-hidden="true"
									class="absolute right-4 top-5 h-5 w-5 text-clay transition-transform group-open:rotate-180"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
								>
									<path d="m6 9 6 6 6-6" />
								</svg>
							</summary>
							<ul class="flex flex-wrap gap-1.5 px-5 pb-5">
								{
									eje.temas.map((tema) => (
										<li class="rounded-full bg-sand/60 px-2.5 py-1 text-xs font-medium text-ink/80">
											{tema}
										</li>
									))
								}
							</ul>
						</details>
					</li>
				))
			}
		</ul>
	</div>
</section>
