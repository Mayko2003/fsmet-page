---
import { Icon } from "astro-icon/components";
import { getStrings } from "../i18n/strings";

const s = getStrings(Astro.currentLocale);
const aportes = s.inscripcion.expo.aportes;
const ejes = s.inscripcion.expo.ejes;

const fieldClass =
	"w-full rounded-xl border border-sand bg-paper px-4 py-3 outline-none ring-clay/30 transition focus:ring-2 disabled:opacity-50";

const rolCardClass =
	"flex cursor-pointer items-start gap-4 rounded-2xl border-2 border-sand bg-paper p-5 transition peer-checked:border-clay peer-checked:bg-gold-soft/30 peer-checked:shadow-sm hover:border-clay/60";

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<section id="inscripcion" class="scroll-mt-24 border-t border-sand bg-paper">
	<div class="mx-auto grid max-w-6xl gap-12 px-5 py-20 md:px-8 lg:grid-cols-[0.9fr_1.1fr]">
		<div data-reveal>
			<p class="text-sm font-semibold tracking-widest text-clay uppercase">{s.inscripcion.label}</p>
			<h2 class="mt-3 font-display text-3xl font-semibold md:text-5xl">{s.inscripcion.h2}</h2>
			<p class="mt-6 text-lg leading-relaxed text-muted">
				{s.inscripcion.introPre} <strong class="font-semibold text-ink">{s.inscripcion.introExpositor}</strong>
				{s.inscripcion.introMid} <strong class="font-semibold text-ink">{s.inscripcion.introOyente}</strong>{s.inscripcion.introPost}
			</p>
			<ul class="mt-8 space-y-3 text-muted">
				{
					s.inscripcion.bullets.map((bullet, i) => (
						<li class="flex gap-3">
							<span class:list={["mt-1.5 h-2 w-2 shrink-0 rounded-full", i === 0 ? "bg-clay" : i === 1 ? "bg-gold" : "bg-sage"]}></span>
							{bullet}
						</li>
					))
				}
			</ul>
		</div>
		<form
			data-reveal
			style="--reveal-delay: 150ms"
			id="form-inscripcion"
			class="rounded-3xl border border-sand bg-cream p-6 shadow-sm md:p-8"
			data-msg-invalid={s.inscripcion.errInvalid}
			data-msg-turnstile={s.inscripcion.errTurnstile}
			data-msg-send={s.inscripcion.errSend}
			data-msg-sending={s.inscripcion.sending}
			data-msg-submit={s.inscripcion.submit}
			novalidate
		>
			<input type="hidden" name="lang" value={Astro.currentLocale ?? "es"} />
			<fieldset>
				<legend class="text-sm font-semibold tracking-widest text-muted uppercase">
					{s.inscripcion.legend}
				</legend>
				<div class="mt-4 grid gap-3 sm:grid-cols-2">
					<label>
						<input
							type="radio"
							name="rol"
							value="oyente"
							required
							checked
							class="peer sr-only"
						/>
						<div class={rolCardClass}>
							<span class="mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-sage/15 text-sage">
								<Icon name="mdi:account-group" class="h-6 w-6" />
							</span>
							<span>
								<span class="block font-display text-lg leading-snug">{s.inscripcion.rolOyente.title}</span>
								<span class="mt-1 block text-sm leading-relaxed text-muted">
									{s.inscripcion.rolOyente.desc}
								</span>
							</span>
						</div>
					</label>
					<label>
						<input
							type="radio"
							name="rol"
							value="expositor"
							required
							class="peer sr-only"
						/>
						<div class={rolCardClass}>
							<span class="mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-clay/15 text-clay">
								<Icon name="mdi:microphone-variant" class="h-6 w-6" />
							</span>
							<span>
								<span class="block font-display text-lg leading-snug">{s.inscripcion.rolExpositor.title}</span>
								<span class="mt-1 block text-sm leading-relaxed text-muted">
									{s.inscripcion.rolExpositor.desc}
								</span>
							</span>
						</div>
					</label>
				</div>
			</fieldset>

			<div class="mt-8 grid gap-5 sm:grid-cols-2">
				<label class="block sm:col-span-2">
					<span class="mb-1.5 block text-sm font-medium">
						{s.inscripcion.fields.nombre} <span class="text-clay" aria-hidden="true">*</span>
					</span>
					<input
						required
						name="nombre"
						type="text"
						autocomplete="name"
						class={fieldClass}
					/>
				</label>
				<label class="block">
					<span class="mb-1.5 block text-sm font-medium">
						{s.inscripcion.fields.email} <span class="text-clay" aria-hidden="true">*</span>
					</span>
					<input
						required
						name="email"
						type="email"
						autocomplete="email"
						class={fieldClass}
					/>
				</label>
				<label class="block">
					<span class="mb-1.5 block text-sm font-medium">
						{s.inscripcion.fields.territorio} <span class="text-clay" aria-hidden="true">*</span>
					</span>
					<input
						required
						name="territorio"
						type="text"
						class={fieldClass}
					/>
				</label>
				<label class="block sm:col-span-2">
					<span class="mb-1.5 block text-sm font-medium">
						{s.inscripcion.fields.organizacion} <span class="font-normal text-muted">{s.inscripcion.fields.opcional}</span>
					</span>
					<input
						name="organizacion"
						type="text"
						class={fieldClass}
					/>
				</label>
				<label class="hidden" aria-hidden="true" tabindex="-1">
					<span>Website</span>
					<input name="website" type="text" tabindex="-1" autocomplete="off" />
				</label>
			</div>

			<div id="panel-expositor" class="mt-6 hidden rounded-2xl border border-sand bg-paper p-5">
				<p class="text-sm font-semibold tracking-widest text-clay uppercase">
					{s.inscripcion.expo.title}
				</p>
				<div class="mt-4 grid gap-5">
					<label class="block">
						<span class="mb-1.5 block text-sm font-medium">
							{s.inscripcion.expo.titulo} <span class="text-clay" aria-hidden="true">*</span>
						</span>
						<input
							required
							name="titulo_exposicion"
							type="text"
							disabled
							class={fieldClass}
						/>
					</label>
					<label class="block">
						<span class="mb-1.5 block text-sm font-medium">
							{s.inscripcion.expo.aporte} <span class="text-clay" aria-hidden="true">*</span>
						</span>
						<select name="aporte" required disabled class={fieldClass}>
							<option value="">{s.inscripcion.expo.elegir}</option>
							{aportes.map((a) => <option value={a}>{a}</option>)}
						</select>
					</label>
					<label class="block">
						<span class="mb-1.5 block text-sm font-medium">
							{s.inscripcion.expo.eje} <span class="text-clay" aria-hidden="true">*</span>
						</span>
						<select name="eje" required disabled class={fieldClass}>
							<option value="">{s.inscripcion.expo.elegir}</option>
							{ejes.map((e) => <option value={e}>{e}</option>)}
						</select>
					</label>
					<label class="block">
						<span class="mb-1.5 block text-sm font-medium">
							{s.inscripcion.expo.resumen} <span class="text-clay" aria-hidden="true">*</span>
						</span>
						<textarea
							required
							name="resumen"
							rows="4"
							disabled
							class={`resize-y ${fieldClass}`}></textarea>
					</label>
					<label class="flex cursor-pointer items-start gap-3">
						<input
							type="checkbox"
							name="consentir_publicar"
							value="si"
							disabled
							class="mt-1 h-4 w-4 shrink-0 accent-clay"
						/>
						<span class="text-sm leading-relaxed text-muted">
							{s.inscripcion.expo.consentimiento}
						</span>
					</label>
				</div>
			</div>

			{
				turnstileSiteKey && (
					<div
						class="cf-turnstile mt-6"
						data-sitekey={turnstileSiteKey}
						data-theme="light"
					/>
				)
			}
			<p id="form-error" class="mt-4 hidden text-sm text-clay-deep"></p>
			<button
				type="submit"
				class="mt-6 w-full rounded-full bg-clay py-3.5 font-semibold text-paper transition hover:bg-clay-deep"
			>
				{s.inscripcion.submit}
			</button>
			<p
				id="form-ok"
				class="mt-4 hidden rounded-2xl bg-sage-soft px-4 py-3 text-sm leading-relaxed text-ink"
			>
				{s.inscripcion.ok}
			</p>
		</form>
	</div>
</section>

{turnstileSiteKey && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />}

<script>
	const form = document.getElementById("form-inscripcion") as HTMLFormElement | null;
	const ok = document.getElementById("form-ok");
	const error = document.getElementById("form-error");
	const panelExpositor = document.getElementById("panel-expositor");

	function togglePanel(panel: HTMLElement | null, show: boolean) {
		if (!panel) return;
		panel.classList.toggle("hidden", !show);
		panel
			.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(
				"input, select, textarea",
			)
			.forEach((field) => {
				field.disabled = !show;
			});
	}

	function syncRol() {
		const rol = form?.querySelector<HTMLInputElement>("input[name='rol']:checked")?.value;
		togglePanel(panelExpositor, rol === "expositor");
	}

	form?.querySelectorAll("input[name='rol']").forEach((input) => {
		input.addEventListener("change", syncRol);
	});
	syncRol();

	const submitBtn = form?.querySelector<HTMLButtonElement>("button[type='submit']");

	form?.addEventListener("submit", async (event) => {
		event.preventDefault();
		const msg = form.dataset;
		if (!form.checkValidity()) {
			error?.classList.remove("hidden");
			if (error) error.textContent = msg.msgInvalid ?? "";
			form.reportValidity();
			return;
		}
		error?.classList.add("hidden");
		ok?.classList.add("hidden");
		const body = new FormData(form);
		const tieneTurnstile = Boolean(form.querySelector(".cf-turnstile"));
		if (tieneTurnstile && !body.get("cf-turnstile-response")) {
			error?.classList.remove("hidden");
			if (error) error.textContent = msg.msgTurnstile ?? "";
			return;
		}
		if (submitBtn) {
			submitBtn.disabled = true;
			submitBtn.textContent = msg.msgSending ?? "";
		}
		try {
			const res = await fetch("/api/inscripcion", {
				method: "POST",
				body,
			});
			if (!res.ok) throw new Error(`HTTP ${res.status}`);
			ok?.classList.remove("hidden");
			form.reset();
			syncRol();
		} catch {
			error?.classList.remove("hidden");
			if (error) error.textContent = msg.msgSend ?? "";
		} finally {
			if (submitBtn) {
				submitBtn.disabled = false;
				submitBtn.textContent = msg.msgSubmit ?? "";
			}
			(window as any).turnstile?.reset();
		}
	});
</script>
