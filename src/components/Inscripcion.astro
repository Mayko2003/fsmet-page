---
import { Icon } from "astro-icon/components";

const aportes = [
	"Investigación / conocimiento",
	"Experiencia práctica / gestión",
	"Formación / educación popular",
	"Activismo / organización comunitaria",
	"Incidencia política / normativa",
	"Innovación productiva / tecnológica",
];

const ejes = [
	"Economía, Territorio y Buen Vivir",
	"Producción, Trabajo y Tramas socioproductivas",
	"Finanzas Éticas, Crédito y Redistribución",
	"Agroecología, Ambiente y Transición Ecológica",
	"Formación, Cultura y Cambio de sentido común",
	"Políticas Públicas e Incidencia",
];

const fieldClass =
	"w-full rounded-xl border border-sand bg-paper px-4 py-3 outline-none ring-clay/30 transition focus:ring-2 disabled:opacity-50";

const rolCardClass =
	"flex cursor-pointer items-start gap-4 rounded-2xl border-2 border-sand bg-paper p-5 transition peer-checked:border-clay peer-checked:bg-gold-soft/30 peer-checked:shadow-sm hover:border-clay/60";
---

<section id="inscripcion" class="scroll-mt-24 border-t border-sand bg-paper">
	<div class="mx-auto grid max-w-6xl gap-12 px-5 py-20 md:px-8 lg:grid-cols-[0.9fr_1.1fr]">
		<div data-reveal>
			<p class="text-sm font-semibold tracking-widest text-clay uppercase">Inscripción</p>
			<h2 class="mt-3 font-display text-3xl font-semibold md:text-5xl">Sumarse al proceso</h2>
			<p class="mt-6 text-lg leading-relaxed text-muted">
				Podés sumarte como <strong class="font-semibold text-ink">expositor/a</strong> —presentando
				una experiencia, investigación o propuesta— o como <strong class="font-semibold text-ink"
					>oyente</strong
				>, participando de las reuniones y del encuentro. El canal oficial sigue en construcción:
				este formulario registra interés para el proceso preparatorio.
			</p>
			<ul class="mt-8 space-y-3 text-muted">
				<li class="flex gap-3">
					<span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-clay"></span>
					Organizaciones, cooperativas y comunidades territoriales
				</li>
				<li class="flex gap-3">
					<span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-gold"></span>
					Universidades, equipos de investigación y formación
				</li>
				<li class="flex gap-3">
					<span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-sage"></span>
					Gobiernos locales e instituciones públicas
				</li>
			</ul>
		</div>
		<form
			data-reveal
			style="--reveal-delay: 150ms"
			id="form-inscripcion"
			class="rounded-3xl border border-sand bg-cream p-6 shadow-sm md:p-8"
			novalidate
		>
			<fieldset>
				<legend class="text-sm font-semibold tracking-widest text-muted uppercase">
					¿Cómo querés participar?
				</legend>
				<div class="mt-4 grid gap-3 sm:grid-cols-2">
					<label>
						<input
							type="radio"
							name="rol"
							value="oyente"
							required
							checked
							class="peer sr-only"
						/>
						<div class={rolCardClass}>
							<span class="mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-sage/15 text-sage">
								<Icon name="mdi:account-group" class="h-6 w-6" />
							</span>
							<span>
								<span class="block font-display text-lg leading-snug">Asisto como oyente</span>
								<span class="mt-1 block text-sm leading-relaxed text-muted">
									Quiero participar de las reuniones y del encuentro
								</span>
							</span>
						</div>
					</label>
					<label>
						<input
							type="radio"
							name="rol"
							value="expositor"
							required
							class="peer sr-only"
						/>
						<div class={rolCardClass}>
							<span class="mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-clay/15 text-clay">
								<Icon name="mdi:microphone-variant" class="h-6 w-6" />
							</span>
							<span>
								<span class="block font-display text-lg leading-snug">Soy expositor/a</span>
								<span class="mt-1 block text-sm leading-relaxed text-muted">
									Presento una experiencia, investigación o propuesta
								</span>
							</span>
						</div>
					</label>
				</div>
			</fieldset>

			<div class="mt-8 grid gap-5 sm:grid-cols-2">
				<label class="block sm:col-span-2">
					<span class="mb-1.5 block text-sm font-medium">Nombre y apellido</span>
					<input
						required
						name="nombre"
						type="text"
						autocomplete="name"
						class={fieldClass}
					/>
				</label>
				<label class="block">
					<span class="mb-1.5 block text-sm font-medium">Correo</span>
					<input
						required
						name="email"
						type="email"
						autocomplete="email"
						class={fieldClass}
					/>
				</label>
				<label class="block">
					<span class="mb-1.5 block text-sm font-medium">Territorio / país</span>
					<input
						required
						name="territorio"
						type="text"
						class={fieldClass}
					/>
				</label>
				<label class="block sm:col-span-2">
					<span class="mb-1.5 block text-sm font-medium">Organización o comunidad</span>
					<input
						name="organizacion"
						type="text"
						class={fieldClass}
					/>
				</label>
				<label class="hidden" aria-hidden="true" tabindex="-1">
					<span>Website</span>
					<input name="website" type="text" tabindex="-1" autocomplete="off" />
				</label>
			</div>

			<div id="panel-expositor" class="mt-6 hidden rounded-2xl border border-sand bg-paper p-5">
				<p class="text-sm font-semibold tracking-widest text-clay uppercase">
					Datos de la exposición
				</p>
				<div class="mt-4 grid gap-5">
					<label class="block">
						<span class="mb-1.5 block text-sm font-medium">Título de la exposición</span>
						<input
							required
							name="titulo_exposicion"
							type="text"
							disabled
							class={fieldClass}
						/>
					</label>
					<label class="block">
						<span class="mb-1.5 block text-sm font-medium">Tipo de aporte</span>
						<select name="aporte" required disabled class={fieldClass}>
							<option value="">Elegir…</option>
							{aportes.map((a) => <option value={a}>{a}</option>)}
						</select>
					</label>
					<label class="block">
						<span class="mb-1.5 block text-sm font-medium">Eje temático</span>
						<select name="eje" required disabled class={fieldClass}>
							<option value="">Elegir…</option>
							{ejes.map((e) => <option value={e}>{e}</option>)}
						</select>
					</label>
					<label class="block">
						<span class="mb-1.5 block text-sm font-medium">
							Resumen de la exposición
						</span>
						<textarea
							required
							name="resumen"
							rows="4"
							disabled
							class={`resize-y ${fieldClass}`}></textarea>
					</label>
				</div>
			</div>

			<p id="form-error" class="mt-4 hidden text-sm text-clay-deep"></p>
			<button
				type="submit"
				class="mt-6 w-full rounded-full bg-clay py-3.5 font-semibold text-paper transition hover:bg-clay-deep"
			>
				Enviar interés
			</button>
			<p
				id="form-ok"
				class="mt-4 hidden rounded-2xl bg-sage-soft px-4 py-3 text-sm leading-relaxed text-ink"
			>
				Gracias, recibimos tu inscripción. El equipo del proceso se va a poner en contacto.
			</p>
		</form>
	</div>
</section>

<script>
	const form = document.getElementById("form-inscripcion") as HTMLFormElement | null;
	const ok = document.getElementById("form-ok");
	const error = document.getElementById("form-error");
	const panelExpositor = document.getElementById("panel-expositor");

	function togglePanel(panel: HTMLElement | null, show: boolean) {
		if (!panel) return;
		panel.classList.toggle("hidden", !show);
		panel
			.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(
				"input, select, textarea",
			)
			.forEach((field) => {
				field.disabled = !show;
			});
	}

	function syncRol() {
		const rol = form?.querySelector<HTMLInputElement>("input[name='rol']:checked")?.value;
		togglePanel(panelExpositor, rol === "expositor");
	}

	form?.querySelectorAll("input[name='rol']").forEach((input) => {
		input.addEventListener("change", syncRol);
	});
	syncRol();

	const submitBtn = form?.querySelector<HTMLButtonElement>("button[type='submit']");

	form?.addEventListener("submit", async (event) => {
		event.preventDefault();
		if (!form.checkValidity()) {
			error?.classList.remove("hidden");
			if (error)
				error.textContent =
					"Revisá el formulario: faltan campos obligatorios para el rol que elegiste.";
			form.reportValidity();
			return;
		}
		error?.classList.add("hidden");
		ok?.classList.add("hidden");
		if (submitBtn) {
			submitBtn.disabled = true;
			submitBtn.textContent = "Enviando…";
		}
		try {
			const res = await fetch("/api/inscripcion", {
				method: "POST",
				body: new FormData(form),
			});
			if (!res.ok) throw new Error(`HTTP ${res.status}`);
			ok?.classList.remove("hidden");
			form.reset();
			syncRol();
		} catch {
			error?.classList.remove("hidden");
			if (error)
				error.textContent =
					"No se pudo enviar la inscripción. Intentá de nuevo en unos minutos.";
		} finally {
			if (submitBtn) {
				submitBtn.disabled = false;
				submitBtn.textContent = "Enviar interés";
			}
		}
	});
</script>
