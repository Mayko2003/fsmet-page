---
import { Icon } from "astro-icon/components";

type Item = { text: string; pendiente?: boolean };

const bloques: { icon: string; title: string; items: Item[] }[] = [
	{
		icon: "mdi:airplane",
		title: "Cómo llegar",
		items: [
			{
				text: "Aeropuerto Gdor. Horacio Guzmán (JUJ), en El Cadillal, a ~33 km de San Salvador de Jujuy.",
			},
			{
				text: "Aeropuerto Martín Miguel de Güemes (SLA), a ~10 km de la ciudad de Salta.",
			},
			{
				text: "Ambas capitales cuentan con terminales de ómnibus con conexiones desde todo el país.",
			},
		],
	},
	{
		icon: "mdi:routes",
		title: "Rutas y traslados",
		items: [
			{
				text: "San Salvador de Jujuy ↔ Salta capital: ~90 km por RN9 (cornisa) o RN34.",
			},
			{
				text: "Traslados oficiales entre sedes y horarios sugeridos.",
				pendiente: true,
			},
		],
	},
	{
		icon: "mdi:terrain",
		title: "Altura y clima",
		items: [
			{
				text: "San Salvador de Jujuy y Salta capital están a ~1.200 msnm; abril es templado y seco.",
			},
			{
				text: "Si recorrés la Quebrada de Humahuaca o la Puna (2.000 a 3.700 msnm), prevé un día de aclimatación.",
			},
		],
	},
];

type Punto = { nombre: string; lat: number; lng: number; detalle: string };

// Hospedajes sugeridos (microcentro de San Salvador de Jujuy)
const hoteles: Punto[] = [
	{
		nombre: "Howard Johnson Plaza Jujuy",
		lat: -24.1831,
		lng: -65.3074,
		detalle: "Güemes 864 · 4★ · salones de eventos",
	},
	{
		nombre: "Amérian Jujuy",
		lat: -24.1889,
		lng: -65.3047,
		detalle: "Av. 19 de Abril 683 · 4★ superior · frente al parque Xibi-Xibi",
	},
	{
		nombre: "Ohasis Hotel Spa",
		lat: -24.1864,
		lng: -65.3101,
		detalle: "Ramírez de Velazco 244 · spa · salón de convenciones",
	},
	{
		nombre: "El Arribo Hotel",
		lat: -24.1857,
		lng: -65.3105,
		detalle: "Belgrano 1263 · 4★ · microcentro",
	},
	{
		nombre: "Hotel Gregorio I",
		lat: -24.1877,
		lng: -65.3044,
		detalle: "Boutique · a metros de Plaza Belgrano y la Catedral",
	},
	{
		nombre: "Hotel ICONICO JUJUY Centro",
		lat: -24.1839,
		lng: -65.3020,
		detalle: "Alvear 627 · desayuno incluido · a 300 m del Cabildo",
	},
	{
		nombre: "Hotel Munay Jujuy",
		lat: -24.1845,
		lng: -65.3100,
		detalle: "Alvear 1230 · opción económica · desayuno y Wi-Fi",
	},
];

const referencias: Punto[] = [
	{
		nombre: "San Salvador de Jujuy",
		lat: -24.1858,
		lng: -65.2995,
		detalle: "Capital provincial · sede por confirmar",
	},
	{
		nombre: "Salta capital",
		lat: -24.7829,
		lng: -65.4232,
		detalle: "Capital provincial · sede por confirmar",
	},
];
---

<section id="info-util" class="scroll-mt-24 border-t border-sand">
	<div class="mx-auto max-w-6xl px-5 py-20 md:px-8">
		<p data-reveal class="text-sm font-semibold tracking-widest text-sky uppercase">
			Información útil
		</p>
		<h2
			data-reveal
			style="--reveal-delay: 80ms"
			class="mt-3 max-w-3xl font-display text-3xl font-semibold md:text-5xl"
		>
			Llegar y quedarse en el territorio
		</h2>
		<p
			data-reveal
			style="--reveal-delay: 150ms"
			class="mt-6 max-w-2xl text-lg leading-relaxed text-muted"
		>
			Datos prácticos para planear el viaje a Jujuy y Salta. Esta sección se completa a medida que
			se confirmen sedes, logística y alojamientos.
		</p>
		<div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
			{
				bloques.map((bloque, i) => (
					<article
						data-reveal
						style={`--reveal-delay: ${i * 80}ms`}
						class="rounded-3xl border border-sand bg-paper p-6 md:p-8"
					>
						<div class="flex items-center gap-4">
							<span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-gold-soft text-clay">
								<Icon name={bloque.icon} class="h-6 w-6" />
							</span>
							<h3 class="font-display text-2xl">{bloque.title}</h3>
						</div>
						<ul class="mt-5 space-y-3">
							{bloque.items.map((item) => (
								<li class="flex items-start gap-3 leading-relaxed text-muted">
									<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-clay/70" />
									<span>
										{item.text}
										{item.pendiente && (
											<span class="ml-2 inline-flex rounded-full bg-sand px-2.5 py-0.5 align-middle text-xs font-semibold text-ink/70">
												Por confirmar
											</span>
										)}
									</span>
								</li>
							))}
						</ul>
					</article>
				))
			}
		</div>
		<article
			data-reveal
			class="mt-4 overflow-hidden rounded-3xl border border-sand bg-paper"
		>
			<div class="grid lg:grid-cols-[0.9fr_1.1fr]">
				<div class="p-6 md:p-8">
					<div class="flex items-center gap-4">
						<span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-gold-soft text-clay">
							<Icon name="mdi:bed-outline" class="h-6 w-6" />
						</span>
						<h3 class="font-display text-2xl">Hospedaje</h3>
					</div>
					<p class="mt-5 leading-relaxed text-muted">
						El mapa muestra hoteles del microcentro de San Salvador de Jujuy como referencia
						inicial. Convenios, tarifas especiales y distancia a la sede final se publican
						cuando estén confirmados.
					</p>
					<ul class="mt-5 space-y-3">
						<li class="flex items-start gap-3 leading-relaxed text-muted">
							<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-clay/70"></span>
							<span>
								Opciones solidarias y alojamiento comunitario
								<span class="ml-2 inline-flex rounded-full bg-sand px-2.5 py-0.5 align-middle text-xs font-semibold text-ink/70">
									Por confirmar
								</span>
							</span>
						</li>
						<li class="flex items-start gap-3 leading-relaxed text-muted">
							<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-clay/70"></span>
							<span>
								Hospedaje en Salta capital
								<span class="ml-2 inline-flex rounded-full bg-sand px-2.5 py-0.5 align-middle text-xs font-semibold text-ink/70">
									Por confirmar
								</span>
							</span>
						</li>
					</ul>
					<div class="mt-6 flex flex-wrap gap-4 text-xs font-medium text-muted">
						<span class="inline-flex items-center gap-2">
							<span class="h-3 w-3 rounded-full border-2 border-paper bg-clay shadow"></span>
							Hospedaje sugerido
						</span>
						<span class="inline-flex items-center gap-2">
							<span class="h-3 w-3 rounded-full border-2 border-paper bg-gold shadow"></span>
							Ciudad anfitriona
						</span>
					</div>
				</div>
				<div
					id="mapa-hospedaje"
					data-hoteles={JSON.stringify(hoteles)}
					data-referencias={JSON.stringify(referencias)}
					class="h-72 border-t border-sand lg:h-auto lg:min-h-96 lg:border-t-0 lg:border-l"
				>
				</div>
			</div>
		</article>
	</div>
</section>

<script>
	import "leaflet/dist/leaflet.css";

	const el = document.getElementById("mapa-hospedaje");

	function initMapa(container: HTMLElement) {
		import("leaflet").then((L) => {
			type Punto = { nombre: string; lat: number; lng: number; detalle: string };
			const hoteles: Punto[] = JSON.parse(container.dataset.hoteles ?? "[]");
			const referencias: Punto[] = JSON.parse(container.dataset.referencias ?? "[]");

			const map = L.map(container, { scrollWheelZoom: false }).setView([-24.1858, -65.2995], 12);

			L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
				attribution:
					'&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
				maxZoom: 18,
			}).addTo(map);

			const markerIcon = (color: string) =>
				L.divIcon({
					className: "",
					html: `<span style="display:block;width:14px;height:14px;border-radius:9999px;background:${color};border:3px solid #fffdf9;box-shadow:0 1px 4px rgba(0,0,0,.35)"></span>`,
					iconSize: [14, 14],
					iconAnchor: [7, 7],
					popupAnchor: [0, -12],
				});

			const iconoHotel = markerIcon("#d86a3a");
			const iconoReferencia = markerIcon("#e4b44c");

			for (const punto of hoteles) {
				L.marker([punto.lat, punto.lng], { icon: iconoHotel })
					.addTo(map)
					.bindPopup(`<strong>${punto.nombre}</strong><br>${punto.detalle}`);
			}

			for (const punto of referencias) {
				L.marker([punto.lat, punto.lng], { icon: iconoReferencia })
					.addTo(map)
					.bindPopup(`<strong>${punto.nombre}</strong><br>${punto.detalle}`);
			}

			const puntos = hoteles.length > 0 ? hoteles : referencias;
			if (puntos.length > 0) {
				map.fitBounds(
					puntos.map((punto) => [punto.lat, punto.lng] as [number, number]),
					{ padding: [40, 40], maxZoom: 15 },
				);
			}
		});
	}

	if (el) {
		new IntersectionObserver(([entry], observer) => {
			if (!entry.isIntersecting) return;
			observer.disconnect();
			initMapa(el);
		}).observe(el);
	}
</script>
