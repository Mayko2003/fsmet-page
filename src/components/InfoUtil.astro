---
import { Icon } from "astro-icon/components";
import { getStrings } from "../i18n/strings";

const s = getStrings(Astro.currentLocale);
const bloques = s.infoutil.bloques;

type Punto = { nombre: string; lat: number; lng: number; detalle: string };

// Hospedajes sugeridos (microcentro de San Salvador de Jujuy)
const coords: { nombre: string; lat: number; lng: number }[] = [
	{ nombre: "Howard Johnson Plaza Jujuy", lat: -24.1831, lng: -65.3074 },
	{ nombre: "Amérian Jujuy", lat: -24.1889, lng: -65.3047 },
	{ nombre: "Ohasis Hotel Spa", lat: -24.1864, lng: -65.3101 },
	{ nombre: "El Arribo Hotel", lat: -24.1857, lng: -65.3105 },
	{ nombre: "Hotel Gregorio I", lat: -24.1877, lng: -65.3044 },
	{ nombre: "Hotel ICONICO JUJUY Centro", lat: -24.1839, lng: -65.302 },
	{ nombre: "Hotel Munay Jujuy", lat: -24.1845, lng: -65.31 },
];

const hoteles: Punto[] = coords.map((hotel, i) => ({
	...hotel,
	detalle: s.infoutil.hoteles[i].detalle,
}));

const referencias: Punto[] = [
	{
		nombre: "San Salvador de Jujuy",
		lat: -24.1858,
		lng: -65.2995,
		detalle: "Capital provincial · sede por confirmar",
	},
	{
		nombre: "Salta capital",
		lat: -24.7829,
		lng: -65.4232,
		detalle: "Capital provincial · sede por confirmar",
	},
];
---

<section id="info-util" class="scroll-mt-24 border-t border-sand">
	<div class="mx-auto max-w-6xl px-5 py-20 md:px-8">
		<p data-reveal class="text-sm font-semibold tracking-widest text-sky uppercase">
			{s.infoutil.label}
		</p>
		<h2
			data-reveal
			style="--reveal-delay: 80ms"
			class="mt-3 max-w-3xl font-display text-3xl font-semibold md:text-5xl"
		>
			{s.infoutil.h2}
		</h2>
		<p
			data-reveal
			style="--reveal-delay: 150ms"
			class="mt-6 max-w-2xl text-lg leading-relaxed text-muted"
		>
			{s.infoutil.intro}
		</p>
		<div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
			{
				bloques.map((bloque, i) => (
					<article
						data-reveal
						style={`--reveal-delay: ${i * 80}ms`}
						class="rounded-3xl border border-sand bg-paper p-6 md:p-8"
					>
						<div class="flex items-center gap-4">
							<span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-gold-soft text-clay">
								<Icon name={bloque.icon} class="h-6 w-6" />
							</span>
							<h3 class="font-display text-2xl">{bloque.title}</h3>
						</div>
						<ul class="mt-5 space-y-3">
							{bloque.items.map((item) => (
								<li class="flex items-start gap-3 leading-relaxed text-muted">
									<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-clay/70" />
									<span>
										{item.text}
										{item.pendiente && (
											<span class="ml-2 inline-flex rounded-full bg-sand px-2.5 py-0.5 align-middle text-xs font-semibold text-ink/70">
												{s.infoutil.pending}
											</span>
										)}
									</span>
								</li>
							))}
						</ul>
					</article>
				))
			}
		</div>
		<article
			data-reveal
			class="mt-4 overflow-hidden rounded-3xl border border-sand bg-paper"
		>
			<div class="grid lg:grid-cols-[0.9fr_1.1fr]">
				<div class="p-6 md:p-8">
					<div class="flex items-center gap-4">
						<span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-gold-soft text-clay">
							<Icon name="mdi:bed-outline" class="h-6 w-6" />
						</span>
						<h3 class="font-display text-2xl">{s.infoutil.hospedaje.title}</h3>
					</div>
					<p class="mt-5 leading-relaxed text-muted">
						{s.infoutil.hospedaje.text}
					</p>
					<ul class="mt-5 space-y-3">
						{
							s.infoutil.hospedaje.pendingItems.map((item) => (
								<li class="flex items-start gap-3 leading-relaxed text-muted">
									<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-clay/70"></span>
									<span>
										{item}
										<span class="ml-2 inline-flex rounded-full bg-sand px-2.5 py-0.5 align-middle text-xs font-semibold text-ink/70">
											{s.infoutil.pending}
										</span>
									</span>
								</li>
							))
						}
					</ul>
					<div class="mt-6 flex flex-wrap gap-4 text-xs font-medium text-muted">
						<span class="inline-flex items-center gap-2">
							<span class="h-3 w-3 rounded-full border-2 border-paper bg-clay shadow"></span>
							{s.infoutil.hospedaje.legendHotel}
						</span>
						<span class="inline-flex items-center gap-2">
							<span class="h-3 w-3 rounded-full border-2 border-paper bg-gold shadow"></span>
							{s.infoutil.hospedaje.legendCity}
						</span>
					</div>
				</div>
				<div
					id="mapa-hospedaje"
					data-hoteles={JSON.stringify(hoteles)}
					data-referencias={JSON.stringify(referencias)}
					class="h-72 border-t border-sand lg:h-auto lg:min-h-96 lg:border-t-0 lg:border-l"
				>
				</div>
				<div class="border-t border-sand px-6 py-5 md:px-8 lg:col-span-2">
					<p class="text-xs font-semibold tracking-widest text-muted uppercase">
						{s.infoutil.hospedaje.listTitle}
					</p>
					<ul class="mt-3 grid gap-x-6 gap-y-2.5 text-sm sm:grid-cols-2">
						{
							hoteles.map((hotel, i) => (
								<li class="flex items-center gap-2.5">
									<span class="grid h-5.5 w-5.5 shrink-0 place-items-center rounded-full bg-clay text-[11px] font-bold text-paper shadow-sm">
										{i + 1}
									</span>
									<span class="text-ink/90">
										<strong class="font-semibold">{hotel.nombre}</strong>
										<span class="text-muted"> · {hotel.detalle}</span>
									</span>
								</li>
							))
						}
					</ul>
				</div>
			</div>
		</article>
	</div>
</section>

<script>
	import "leaflet/dist/leaflet.css";

	const el = document.getElementById("mapa-hospedaje");

	function initMapa(container: HTMLElement) {
		import("leaflet").then((L) => {
			type Punto = { nombre: string; lat: number; lng: number; detalle: string };
			const hoteles: Punto[] = JSON.parse(container.dataset.hoteles ?? "[]");
			const referencias: Punto[] = JSON.parse(container.dataset.referencias ?? "[]");

			const map = L.map(container, { scrollWheelZoom: false }).setView([-24.1858, -65.2995], 12);

			L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
				attribution:
					'&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
				maxZoom: 18,
			}).addTo(map);

			const iconoHotel = (n: number) =>
				L.divIcon({
					className: "",
					html: `<span style="display:grid;place-items:center;width:22px;height:22px;border-radius:9999px;background:#d86a3a;color:#fffdf9;font:700 11px/1 'Outfit',sans-serif;border:2px solid #fffdf9;box-shadow:0 1px 4px rgba(0,0,0,.4)">${n}</span>`,
					iconSize: [22, 22],
					iconAnchor: [11, 11],
					popupAnchor: [0, -14],
				});

			const iconoReferencia = L.divIcon({
				className: "",
				html: `<span style="display:block;width:16px;height:16px;border-radius:9999px;background:#e4b44c;border:3px solid #fffdf9;box-shadow:0 1px 4px rgba(0,0,0,.4)"></span>`,
				iconSize: [16, 16],
				iconAnchor: [8, 8],
				popupAnchor: [0, -12],
			});

			hoteles.forEach((punto, i) => {
				L.marker([punto.lat, punto.lng], { icon: iconoHotel(i + 1) })
					.addTo(map)
					.bindPopup(`<strong>${i + 1}. ${punto.nombre}</strong><br>${punto.detalle}`);
			});

			for (const punto of referencias) {
				L.marker([punto.lat, punto.lng], { icon: iconoReferencia })
					.addTo(map)
					.bindPopup(`<strong>${punto.nombre}</strong><br>${punto.detalle}`)
					.bindTooltip(punto.nombre, {
						permanent: true,
						direction: "top",
						offset: [0, -12],
						className: "etiqueta-ciudad",
					});
			}

			const puntos = hoteles.length > 0 ? hoteles : referencias;
			if (puntos.length > 0) {
				map.fitBounds(
					puntos.map((punto) => [punto.lat, punto.lng] as [number, number]),
					{ padding: [40, 40], maxZoom: 15 },
				);
			}
		});
	}

	if (el) {
		new IntersectionObserver(([entry], observer) => {
			if (!entry.isIntersecting) return;
			observer.disconnect();
			initMapa(el);
		}).observe(el);
	}
</script>
