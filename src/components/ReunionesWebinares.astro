---
import { Icon } from "astro-icon/components";
import { getEmDashCollection } from "emdash";
import { Image as EmDashImage } from "emdash/ui";
import { getStrings } from "../i18n/strings";

interface Props {
	previewEntry?: { data: WebinarData } | null;
}

const { previewEntry } = Astro.props;
const s = getStrings(Astro.currentLocale);
const locale = Astro.currentLocale ?? "es";

type WebinarData = {
	title: string;
	speaker: string;
	event_date: string | Date;
	date_label?: string | null;
	description?: string | null;
	youtube_url?: string | null;
	order?: number | null;
	image?: {
		id?: string;
		src?: string;
		alt?: string;
		width?: number;
		height?: number;
		provider?: string;
		meta?: Record<string, unknown>;
	} | null;
};

const queryWebinars = (queryLocale: string) =>
	getEmDashCollection("webinars", {
		locale: queryLocale,
		orderBy: { order: "asc", event_date: "asc" },
	});

let { entries: reuniones, error } = await queryWebinars(locale);

// Si todavía no hay traducciones para este idioma, mostramos el contenido
// publicado en español en lugar de dejar la sección vacía.
if (!error && reuniones.length === 0 && locale !== "es") {
	({ entries: reuniones, error } = await queryWebinars("es"));
}

if (error) {
	console.error("[emdash] No se pudieron cargar los webinares:", error);
	reuniones = [];
}

const formatDate = (value: string | Date) => {
	const date = value instanceof Date ? value : new Date(value);
	if (Number.isNaN(date.getTime())) return "";

	return new Intl.DateTimeFormat(locale, {
		day: "numeric",
		month: "short",
		year: "numeric",
		hour: "2-digit",
		minute: "2-digit",
		timeZone: "America/Argentina/Buenos_Aires",
	}).format(date);
};

const toWebinar = (data: WebinarData) => ({
	tematica: data.title,
	expositor: data.speaker,
	fecha: data.date_label || formatDate(data.event_date),
	descripcion: data.description,
	youtube: data.youtube_url || undefined,
	imagenMedia: data.image ?? null,
	imagenAlt: data.image?.alt || `${s.reuniones.webinar}: ${data.title}`,
	imagenFallback: "/img/webinar-default.svg",
});

const webinars = reuniones.map((entry) => toWebinar(entry.data as WebinarData));

if (previewEntry) {
	webinars.unshift(toWebinar(previewEntry.data));
}
---

<section id="reuniones" class="scroll-mt-24 border-t border-sand bg-paper">
	<div class="mx-auto max-w-6xl px-5 py-20 md:px-8">
		{
			previewEntry && (
				<p class="mb-8 inline-flex items-center gap-2 rounded-full border border-gold/40 bg-gold-soft px-4 py-2 text-sm font-semibold text-ink">
					<Icon name="mdi:eye-outline" class="h-4 w-4" />
					Vista previa · este webinar todavía es un borrador
				</p>
			)
		}
		<p data-reveal class="text-sm font-semibold tracking-widest text-sage uppercase">
			{s.reuniones.label}
		</p>
		<h2
			data-reveal
			style="--reveal-delay: 80ms"
			class="mt-3 max-w-3xl font-display text-3xl font-semibold md:text-5xl"
		>
			{s.reuniones.h2}
		</h2>
		<p
			data-reveal
			style="--reveal-delay: 150ms"
			class="mt-6 max-w-2xl text-lg leading-relaxed text-muted"
		>
			{s.reuniones.intro}
		</p>
		{
			webinars.length ? (
				<ul class="mt-12 grid items-stretch gap-4 sm:grid-cols-2 lg:grid-cols-3">
					{webinars.map((reunion, i) => (
						<li
							data-reveal
							style={`--reveal-delay: ${i * 60}ms`}
							class="flex flex-col overflow-hidden rounded-3xl border border-sand bg-cream"
						>
							<button
								type="button"
								data-webinar-zoom
								data-title={reunion.tematica}
								aria-label={`${s.reuniones.zoom}: ${reunion.tematica}`}
								class="group relative block aspect-[16/9] w-full cursor-zoom-in overflow-hidden border-b border-sand bg-sand"
							>
								{reunion.imagenMedia ? (
									<EmDashImage
										image={reunion.imagenMedia}
										alt={reunion.imagenAlt}
										class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.02]"
									/>
								) : (
									<img
										src={reunion.imagenFallback}
										alt={reunion.imagenAlt}
										width="1200"
										height="675"
										loading="lazy"
										decoding="async"
										class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.02]"
									/>
								)}
								<span class="pointer-events-none absolute inset-0 flex items-end justify-end bg-gradient-to-t from-ink/25 to-transparent p-3 opacity-0 transition group-hover:opacity-100 group-focus-visible:opacity-100">
									<span class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-ink/75 text-paper ring-1 ring-paper/30 backdrop-blur-sm">
										<Icon name="mdi:magnify-plus-outline" class="h-5 w-5" />
									</span>
								</span>
							</button>
							<div class="flex flex-1 flex-col p-6">
								<div class="flex items-center justify-between gap-3">
									<span class="inline-flex items-center gap-1.5 rounded-full bg-gold-soft px-3 py-1 text-xs font-semibold text-ink/80">
										<Icon name="mdi:calendar-month" class="h-4 w-4" />
										{reunion.fecha}
									</span>
									<span class="text-xs font-semibold tracking-widest text-muted uppercase">
										{s.reuniones.webinar}
									</span>
								</div>
								<h3 class="mt-4 font-display text-xl leading-snug">{reunion.tematica}</h3>
								<p class="mt-3 flex items-center gap-2 text-sm text-muted">
									<Icon name="mdi:account" class="h-4 w-4 shrink-0 text-clay" />
									{reunion.expositor}
								</p>
								{reunion.descripcion && (
									<p class="mt-3 text-sm leading-relaxed text-muted">{reunion.descripcion}</p>
								)}
								<div class="mt-auto pt-6">
									{reunion.youtube ? (
										<a
											href={reunion.youtube}
											target="_blank"
											rel="noopener noreferrer"
											class="inline-flex items-center gap-2 rounded-full bg-clay px-4 py-2 text-sm font-semibold text-paper transition hover:bg-clay-deep"
										>
											<Icon name="mdi:youtube" class="h-5 w-5" />
											{s.reuniones.live}
										</a>
									) : (
										<span class="inline-flex items-center gap-2 rounded-full border border-dashed border-sand px-4 py-2 text-sm font-medium text-muted">
											<Icon name="mdi:youtube" class="h-5 w-5" />
											{s.reuniones.soon}
										</span>
									)}
								</div>
							</div>
						</li>
					))}
				</ul>
			) : (
				<div
					data-reveal
					class="mt-12 flex flex-col items-center gap-4 rounded-3xl border border-dashed border-sand bg-cream px-6 py-14 text-center"
				>
					<span class="flex h-14 w-14 items-center justify-center rounded-full bg-gold-soft text-clay">
						<Icon name="mdi:video-outline" class="h-7 w-7" />
					</span>
					<p class="font-display text-2xl font-semibold">{s.reuniones.empty}</p>
					<p class="max-w-xl leading-relaxed text-muted">{s.reuniones.emptyText}</p>
				</div>
			)
		}
	</div>
</section>

<dialog
	id="webinar-lightbox"
	aria-label={s.reuniones.zoom}
	class="m-auto w-full max-w-6xl bg-transparent p-0 text-paper"
>
	<div class="relative flex max-h-[92vh] w-full max-w-[94vw] flex-col items-center justify-center">
		<button
			type="button"
			data-close-lightbox
			aria-label={s.reuniones.close}
			class="fixed top-4 right-4 z-10 inline-flex h-11 w-11 items-center justify-center rounded-full bg-paper/10 text-paper ring-1 ring-paper/30 backdrop-blur transition hover:bg-paper/20 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-paper"
		>
			<Icon name="mdi:close" class="h-6 w-6" />
		</button>
		<img
			id="webinar-lightbox-image"
			alt=""
			class="max-h-[82vh] w-auto max-w-full rounded-2xl bg-ink/20 object-contain shadow-2xl ring-1 ring-paper/20"
		/>
		<p id="webinar-lightbox-caption" class="mt-4 max-w-2xl text-center text-sm font-medium text-paper/85"></p>
	</div>
</dialog>

<style>
	#webinar-lightbox::backdrop {
		background: rgb(42 34 28 / 0.82);
		backdrop-filter: blur(6px);
	}
</style>

<script>
	const lightbox = document.getElementById("webinar-lightbox") as HTMLDialogElement | null;
	const lightboxImage = document.getElementById("webinar-lightbox-image") as HTMLImageElement | null;
	const lightboxCaption = document.getElementById("webinar-lightbox-caption");

	document.querySelectorAll<HTMLButtonElement>("[data-webinar-zoom]").forEach((button) => {
		button.addEventListener("click", () => {
			const image = button.querySelector("img");
			if (!lightbox || !lightboxImage || !image) return;

			// Huge 2x candidates (e.g. 9940w) are rejected or very slow in the
			// image optimizer, so cap the lightbox source at a sane width.
			const MAX_LIGHTBOX_WIDTH = 2560;
			const srcset = image.getAttribute("srcset");
			const candidates = srcset
				? srcset
						.split(",")
						.map((part) => {
							const [url, descriptor = ""] = part.trim().split(/\s+/);
							const width = Number.parseInt(descriptor, 10);
							return url ? { url, width: Number.isFinite(width) ? width : 0 } : null;
						})
						.filter((candidate): candidate is { url: string; width: number } => candidate !== null)
				: [];
			const largestWithinLimit = candidates
				.filter((candidate) => candidate.width > 0 && candidate.width <= MAX_LIGHTBOX_WIDTH)
				.at(-1);
			const bestCandidate = largestWithinLimit ?? candidates.at(-1);

			// `currentSrc` is "" (not null) while a lazy image has not loaded yet,
			// so `||` is required to fall back to the `src` attribute.
			lightboxImage.src = bestCandidate?.url || image.currentSrc || image.src;
			lightboxImage.alt = image.alt || "";
			if (lightboxCaption) {
				lightboxCaption.textContent = button.dataset.title || image.alt || "";
			}

			document.documentElement.classList.add("overflow-hidden");
			lightbox.showModal();
		});
	});

	document.querySelector("[data-close-lightbox]")?.addEventListener("click", () => {
		lightbox?.close();
	});

	lightbox?.addEventListener("click", (event) => {
		if (event.target === lightbox) lightbox.close();
	});

	lightbox?.addEventListener("close", () => {
		document.documentElement.classList.remove("overflow-hidden");
		if (lightboxImage) {
			lightboxImage.removeAttribute("src");
			lightboxImage.alt = "";
		}
	});
</script>
